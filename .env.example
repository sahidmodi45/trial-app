# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...); use the anon key if only legacy keys are shown
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Site URL used for share links and metadataBase; http://localhost:3000 in local dev
NEXT_PUBLIC_SITE_URL=
# Supabase secret key (sb_secret_...); scripts/ only, never in Vercel, never NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# Phone number used by scripts/seed-demo.mjs so demo WhatsApp buttons never message a stranger
DEMO_PHONE=
